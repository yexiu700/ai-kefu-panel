{
  "name": "ai-kefu-panel",
  "version": "0.2.35",
  "description": "电商客服 Windows 桌面话术面板与 AI 助手（自动跟随聊天窗、飞书话术同步、图文一键填入与发送）",
  "main": "electron/main.js",
  "productName": "AI客服",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:panel": "electron . -- --window=panel",
    "start:manager": "electron . -- --window=manager",
    "dist": "electron-builder --win nsis",
    "check": "node scripts/run-tests.cjs --check-only",
    "test": "node scripts/run-tests.cjs",
    "test:win": "node scripts/run-tests.cjs --win",
    "test:unit": "node scripts/unit-feishu-sync.mjs",
    "test:media": "node scripts/unit-media.cjs",
    "smoke:ui": "node scripts/smoke-ui-protocol.cjs"
  },
  "dependencies": {
    "koffi": "3.3.8",
    "pinyin-pro": "^3.29.5"
  },
  "build": {
    "appId": "com.arzopa.aikefu",
    "productName": "AI客服",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!**/*.bak*",
      "!**/*.pre-cleanup*",
      "!**/claude-code*",
      "!**/.env",
      "!**/.env.*",
      "!**/feishu.env",
      "!**/.api_key"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "AI客服",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null,
    "asar": true,
    "asarUnpack": [
      "electron/win32-daemon.ps1",
      "node_modules/@koromix/koffi-win32-x64/**/*"
    ]
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "electron": "^34.3.0"
  },
  "author": "arzopa"
}
